[Unit]
Description=email-triage web + background workers
Documentation=https://github.com/Unlimited-Data-Works-LLC/Email-Triage
Wants=network-online.target
After=network-online.target podman.socket

[Container]
# Pinned release image from GHCR. Pull the tag you want to run; the unit
# does not build. To upgrade: change the tag and `systemctl restart
# email-triage.service`.
Image=ghcr.io/unlimited-data-works-llc/email-triage:0.1.2
ContainerName=email-triage

# Host:container port mapping. The app listens on 8080 inside the
# container; publish it on whatever host port is free for you.
PublishPort=8080:8080

# Timezone — the log formatter reads the container TZ; without it logs
# fall back to UTC. Set this to your local zone if you prefer local-time
# logs (e.g. TZ=America/New_York).
Environment=TZ=UTC
Volume=/etc/localtime:/etc/localtime:ro

# Persistent data + config volumes. Point these at host paths you control;
# triage.db (SQLCipher-encrypted) and the config file live under /app/data
# and /app/config respectively.
Volume=/srv/email-triage/data:/app/data
Volume=/srv/email-triage/config:/app/config

# Master key — a Podman secret named ET_MASTER_KEY. A missing secret makes
# the app raise SecretNotFound at startup and the container exits.
Secret=ET_MASTER_KEY

# Graceful shutdown cap. A clean drain (watcher stop + IMAP logout + any
# push flush) finishes well inside 30s; systemd SIGKILLs after this.
StopTimeout=30

[Service]
# Restart on transient crashes, but back off so a broken config does not
# crash-loop at maximum rate.
Restart=on-failure
RestartSec=10

[Install]
# Start at boot and when reaching default.target.
WantedBy=multi-user.target default.target
